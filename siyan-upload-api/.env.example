# Host port (8790은 ticket-queue, 8787은 gateway)
SIYAN_HOST_PORT=8800

# NAS 공유 폴더 (호스트 경로 → 컨테이너 /watch, /done, /fail)
SIYAN_WATCH_HOST=/volume1/04. 콘텐츠/_시안_inbox
SIYAN_DONE_HOST=/volume1/04. 콘텐츠/_시안_done
SIYAN_FAIL_HOST=/volume1/04. 콘텐츠/_시안_fail

# YouTube OAuth (로컬에서 npm run auth 로 refresh token 발급)
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# unlisted(일부 공개) 고정 — public(공개)은 코드에서 거부
PRIVACY_STATUS=unlisted

# 제목/설명 — {name} {filename} {uploadedAt}
TITLE_TEMPLATE={name}
DESCRIPTION_TEMPLATE=시안 자동 업로드\n원본: {filename}\n시각: {uploadedAt}
YOUTUBE_TAGS=시안,피드백
CATEGORY_ID=22

# 선택: 업로드 후 재생목록에 추가
PLAYLIST_ID=

# 복사 완료 판정 (ms), 최소 파일 크기 (bytes)
STABLE_MS=8000
MIN_BYTES=100000
UPLOAD_CONCURRENCY=1

# API 보호 (비우면 보호 없음 — LAN 전용 권장)
ADMIN_SECRET=

CORS_ORIGIN=*
VIDEO_EXTENSIONS=.mp4,.mov,.mkv,.m4v,.avi,.webm
